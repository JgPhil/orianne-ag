{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oriannedecoratrice-com",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "main": "worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "oriannedecoratrice.com",
      "custom_domain": true
    },
    {
      "pattern": "www.oriannedecoratrice.com",
      "custom_domain": true
    }
  ]
}
