{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oriannedecoratrice-com",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  },
  "routes": [
    {
      "pattern": "oriannedecoratrice.com",
      "custom_domain": true
    },
    {
      "pattern": "www.oriannedecoratrice.com",
      "custom_domain": true
    }
  ]
}
